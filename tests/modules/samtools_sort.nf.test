nextflow_process {
    name "Test SAMTOOLS_SORT"
    script "pipeline/modules/samtools_sort.nf"
    process "SAMTOOLS_SORT"

    test("stub: outputs sorted bam and bai") {
        options "-stub"

        when {
            params {
                outdir = "${outputDir}"
            }
            process {
                """
                input[0] = ['sample_test', file('${projectDir}/tests/data/fasta/test_contigs.fna')]
                """
            }
        }

        then {
            assert process.success
            assert process.out.sorted_bam.size() == 1
            assert process.out.sorted_bam[0][0] == 'sample_test'
            assert new File(process.out.sorted_bam[0][1].toString()).name == 'sample_test_sorted.bam'
            assert new File(process.out.sorted_bam[0][2].toString()).name == 'sample_test_sorted.bam.bai'
            assert process.out.log.size() == 1
        }
    }
}
