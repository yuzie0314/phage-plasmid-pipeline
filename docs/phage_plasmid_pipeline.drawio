      <mxGeometry x="1580" y="860" width="200" height="70" as="geometry" />
    </mxCell>

    <!-- ch_flagstat emit -->
    <mxCell id="flagstat_emit" value="emit: ch_flagstat_mge&lt;br&gt;&lt;font color='#888'&gt;→ de novo MultiQC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f7ff;strokeColor=#5aaed4;fontSize=10;fontStyle=2;" vertex="1" parent="1">
