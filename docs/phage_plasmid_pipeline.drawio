    <mxCell id="merge_proc" value="&lt;b&gt;process: MERGE_MGE&lt;/b&gt;&lt;br&gt;cat phage.fna plasmid.fna&lt;br&gt;→ combined_MGE.fna&lt;br&gt;&lt;font color='#888'&gt;(+ provirus if enabled)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
