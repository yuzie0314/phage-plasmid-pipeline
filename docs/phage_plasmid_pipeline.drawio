    </mxCell>

    <!-- ═══ LANE 4: MAPPING ═══ -->

    <!-- DETECT_READ_LENGTH -->
    <mxCell id="detect_proc" value="&lt;b&gt;process: DETECT_READ_LENGTH&lt;/b&gt;&lt;br&gt;seqkit head -n 200000 | seqkit stats&lt;br&gt;→ AVG_LEN (per sample)&lt;br&gt;&lt;font color='#888'&gt;seqkit.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="130" y="830" width="240" height="85" as="geometry" />
    </mxCell>

    <!-- aligner_log -->
    <mxCell id="aligner_log" value="aligner_selection.log&lt;br&gt;sample_id | avg_len | aligner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c8a400;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="130" y="935" width="210" height="45" as="geometry" />
    </mxCell>

    <!-- branch diamond -->
    <mxCell id="branch_op" value="&lt;b&gt;.branch { }&lt;/b&gt;&lt;br&gt;&lt;br&gt;auto:&lt;br&gt;≥150 → strobealign&lt;br&gt;≥100 → bwamem2&lt;br&gt;&lt;100 → bowtie2&lt;br&gt;&lt;br&gt;force: params.aligner" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=10;align=center;" vertex="1" parent="1">
      <mxGeometry x="440" y="810" width="210" height="150" as="geometry" />
    </mxCell>

    <!-- STROBEALIGN -->
    <mxCell id="strob_proc" value="&lt;b&gt;process: STROBEALIGN&lt;/b&gt;&lt;br&gt;≥ 150 bp PE&lt;br&gt;strobealign -t ${task.cpus}&lt;br&gt;&lt;font color='#888'&gt;strobealign.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="740" y="810" width="200" height="80" as="geometry" />
    </mxCell>

    <!-- BWAMEM2 -->
    <mxCell id="bwa_proc" value="&lt;b&gt;process: BWAMEM2&lt;/b&gt;&lt;br&gt;100–149 bp&lt;br&gt;bwa-mem2 mem -t ${task.cpus}&lt;br&gt;&lt;font color='#888'&gt;bwamem2.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="740" y="905" width="200" height="80" as="geometry" />
    </mxCell>

    <!-- BOWTIE2 -->
    <mxCell id="bt2_proc" value="&lt;b&gt;process: BOWTIE2&lt;/b&gt;&lt;br&gt;&lt; 100 bp (fallback)&lt;br&gt;bowtie2 -p ${task.cpus}&lt;br&gt;&lt;font color='#888'&gt;bowtie2.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="740" y="995" width="200" height="80" as="geometry" />
    </mxCell>

    <!-- mix operator -->
    <mxCell id="mix_op" value="&lt;b&gt;.mix()&lt;/b&gt;&lt;br&gt;STROBEALIGN.out.bam&lt;br&gt;.mix( BWAMEM2.out.bam )&lt;br&gt;.mix( BOWTIE2.out.bam )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1020" y="890" width="200" height="75" as="geometry" />
    </mxCell>

    <!-- SAMTOOLS_SORT -->
    <mxCell id="sam_sort" value="&lt;b&gt;process: SAMTOOLS_SORT&lt;/b&gt;&lt;br&gt;samtools sort + index&lt;br&gt;→ [sample].sorted.bam&lt;br&gt;&lt;font color='#888'&gt;samtools.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1300" y="855" width="200" height="80" as="geometry" />
    </mxCell>

    <!-- SAMTOOLS_FLAGSTAT -->
    <mxCell id="sam_flagstat" value="&lt;b&gt;process: SAMTOOLS_FLAGSTAT&lt;/b&gt;&lt;br&gt;samtools flagstat&lt;br&gt;→ [sample]_flagstat.txt&lt;br&gt;&lt;font color='#888'&gt;samtools.sif&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
