    <!-- ═══ LANE 5: QUANTIFICATION ═══ -->

    <!-- COVERM_PHAGE -->
    <mxCell id="coverm_phage" value="&lt;b&gt;process: COVERM_PHAGE&lt;/b&gt;&lt;br&gt;--min-read-percent-identity 0.85&lt;br&gt;&lt;font color='#888'&gt;phage: high diversity&lt;/font&gt;&lt;br&gt;coverm.sif  [label: high]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1300" y="1085" width="230" height="85" as="geometry" />
    </mxCell>

    <!-- COVERM_PLASMID -->
    <mxCell id="coverm_plasmid" value="&lt;b&gt;process: COVERM_PLASMID&lt;/b&gt;&lt;br&gt;--min-read-percent-identity 0.90&lt;br&gt;&lt;font color='#888'&gt;plasmid: conservative&lt;/font&gt;&lt;br&gt;coverm.sif  [label: high]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1580" y="1085" width="230" height="85" as="geometry" />
    </mxCell>

    <!-- ═══ LANE 6: OUTPUT ═══ -->

    <mxCell id="abund_phage" value="&lt;b&gt;phage_abundance.tsv&lt;/b&gt;&lt;br&gt;samples × phage contigs&lt;br&gt;(RPKM / TPM / covered_fraction)&lt;br&gt;results/abundance/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
