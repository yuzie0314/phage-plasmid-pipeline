Bootstrap: docker
From: antoniopcamargo/genomad:1.8.0

%labels
    maintainer pipeline
    tool       genomad
    version    1.8.0

%environment
    export PATH="/opt/conda/bin:$PATH"

%post
    apt-get update -qq && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/* || \
    conda install -y -c conda-forge procps-ng || true
    export PATH="/opt/conda/bin:$PATH"
    genomad --version
