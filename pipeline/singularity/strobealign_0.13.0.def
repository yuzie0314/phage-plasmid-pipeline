Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    maintainer pipeline
    tool       strobealign
    version    0.13.0

%post
    /usr/local/bin/micromamba install -y -n base \
        -c conda-forge -c bioconda \
        strobealign=0.13.0
    /usr/local/bin/micromamba clean -y --all
    /opt/conda/bin/strobealign --version

%environment
    export PATH="/opt/conda/bin:$PATH"
    export MAMBA_ROOT_PREFIX="/opt/conda"
