Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    maintainer pipeline
    tool       fastp
    version    0.23.4

%post
    export MAMBA_ROOT_PREFIX=/opt/conda
    /usr/bin/micromamba install -y -n base \
        -c conda-forge -c bioconda \
        fastp=0.23.4
    /usr/bin/micromamba clean -y --all
    /opt/conda/bin/fastp --version 2>&1 | head -1

%environment
    export PATH="/opt/conda/bin:$PATH"
    export MAMBA_ROOT_PREFIX="/opt/conda"
