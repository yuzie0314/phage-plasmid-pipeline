Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    maintainer pipeline
    tool       coverm
    version    0.7.0

%post
    /usr/local/bin/micromamba install -y -n base \
        -c conda-forge -c bioconda \
        coverm=0.7.0
    /usr/local/bin/micromamba clean -y --all
    /opt/conda/bin/coverm --version

%environment
    export PATH="/opt/conda/bin:$PATH"
    export MAMBA_ROOT_PREFIX="/opt/conda"
