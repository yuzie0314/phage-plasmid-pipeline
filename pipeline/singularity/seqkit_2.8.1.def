Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    maintainer pipeline
    tool       seqkit
    version    2.8.1

%post
    /usr/local/bin/micromamba install -y -n base \
        -c conda-forge -c bioconda \
        seqkit=2.8.1
    /usr/local/bin/micromamba clean -y --all
    /opt/conda/bin/seqkit version

%environment
    export PATH="/opt/conda/bin:$PATH"
    export MAMBA_ROOT_PREFIX="/opt/conda"
