/*
 * Test profile configuration
 * Minimal resources for stub / CI tests — overrides base.config
 */

params {
    input                       = "${projectDir}/../tests/data/samplesheets/valid.csv"
    genomad_db                  = "${projectDir}/../tests/data/fasta"   // placeholder dir
    outdir                      = "${outputDir}"

    min_contig_length           = 4000
    reads_mode                  = 'raw'
    aligner                     = 'bwamem2'
    run_provirus                = false
    coverm_min_identity_phage   = 0.85
    coverm_min_identity_plasmid = 0.90
    multiqc_emit                = false
}

process {
    withLabel: 'low'    { cpus = 1; memory = '1.GB'; time = '5.m'  }
    withLabel: 'medium' { cpus = 2; memory = '2.GB'; time = '10.m' }
    withLabel: 'high'   { cpus = 2; memory = '4.GB'; time = '10.m' }
    errorStrategy = 'terminate'
    maxRetries    = 0
}
