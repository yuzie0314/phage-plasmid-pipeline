/*
 * Singularity container paths per process
 * Update image paths to match your NFS/local container store.
 */

params {
    sif_dir = '/containers/sif'   // override on your system
}

process {
    withName: 'FILTER_CONTIGS'      { container = "${params.sif_dir}/seqkit_2.8.1.sif"      }
    withName: 'GENOMAD'             { container = "${params.sif_dir}/genomad_1.8.0.sif"      }
    withName: 'MERGE_MGE'           { container = "${params.sif_dir}/seqkit_2.8.1.sif"       }
    withName: 'BUILD_INDEX'         { container = "${params.sif_dir}/bwamem2_2.2.1.sif"      }
    withName: 'QC_TRIM'             { container = "${params.sif_dir}/fastp_0.23.4.sif"       }
    withName: 'REMOVE_HOST_READS'   { container = "${params.sif_dir}/bmtagger_3.306.sif"     }
    withName: 'DETECT_READ_LENGTH'  { container = "${params.sif_dir}/seqkit_2.8.1.sif"       }
    withName: 'STROBEALIGN'         { container = "${params.sif_dir}/strobealign_0.13.0.sif" }
    withName: 'BWAMEM2'             { container = "${params.sif_dir}/bwamem2_2.2.1.sif"      }
    withName: 'BOWTIE2'             { container = "${params.sif_dir}/bowtie2_2.5.3.sif"      }
    withName: 'SAMTOOLS_SORT'       { container = "${params.sif_dir}/samtools_1.19.2.sif"    }
    withName: 'SAMTOOLS_FLAGSTAT'   { container = "${params.sif_dir}/samtools_1.19.2.sif"    }
    withName: 'COVERM_PHAGE'        { container = "${params.sif_dir}/coverm_0.7.0.sif"       }
    withName: 'COVERM_PLASMID'      { container = "${params.sif_dir}/coverm_0.7.0.sif"       }
}
