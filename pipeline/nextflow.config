/*
 * Phage/Plasmid Detection & Abundance Pipeline
 * Nextflow configuration
 */

params {
    // Input
    input               = null
    input_type          = 'local'       // 'local' | 's3'

    // Output
    outdir              = './results'

    // Databases (NFS mounts, read-only)
    genomad_db          = null
    host_genome_bitmask = null
    host_genome_srprism = null

    // Contig filtering
    min_contig_length   = 4000

    // Reads preprocessing mode
    // 'raw'                    → raw reads directly into mapping
    // 'host_removed'           → bmtagger → mapping
    // 'trimmed_host_removed'   → fastp → bmtagger → mapping
    reads_mode          = 'raw'

    // Aligner selection
    aligner             = 'auto'        // 'auto' | 'strobealign' | 'bwamem2' | 'bowtie2'
    strobealign_min_len = 150
    bwamem2_min_len     = 100

    // Optional modules
    run_provirus        = false

    // CoverM identity thresholds (per-MGE-type)
    coverm_min_identity_phage   = 0.85
    coverm_min_identity_plasmid = 0.90

    // MultiQC integration (emit to de novo pipeline)
    multiqc_emit        = true
}

// Load base resource config
includeConfig 'conf/base.config'

// Load Singularity container config
includeConfig 'conf/singularity.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}

// Global process settings
process {
    errorStrategy = 'retry'
    maxRetries    = 2
}

manifest {
    name            = 'phage-plasmid-pipeline'
    description     = 'Phage/Plasmid Detection & Abundance Pipeline'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
