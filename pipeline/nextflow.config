/*
 * Phage/Plasmid Detection & Abundance Pipeline
 * Nextflow configuration
 */

params {
    // Input
    input               = null
    input_type          = 'local'       // 'local' | 's3'

    // Output
    outdir              = './results'

    // Databases (NFS mounts, read-only)
    genomad_db          = null  // path to geNomad DB directory, e.g. /nfs/databases/genomad_db/

    // ── bmtagger hg38 index ──────────────────────────────────────────────────
    // Only required when reads_mode = 'host_removed' or 'trimmed_host_removed'.
    //
    // If you already have the index files, set the paths below directly
    // instead of passing them on the command line every run.
    //
    //   host_genome_bitmask — absolute path to the .bitmask FILE
    //     e.g.  host_genome_bitmask = '/nfs/databases/hg38_bmtagger/hg38.bitmask'
    //
    //   host_genome_srprism — absolute path to the srprism index PREFIX (no extension)
    //     e.g.  host_genome_srprism = '/nfs/databases/hg38_bmtagger/hg38.srprism'
    //     bmtagger -x resolves .srprism.amp / .idx / .map / .pmp / .rmp / .ssd automatically
    //
    // Leave as null if reads_mode = 'raw' (host removal is skipped entirely).
    host_genome_bitmask = null
    host_genome_srprism = null

    // ── Singularity NFS bind paths ───────────────────────────────────────────
    // Comma-separated mount points to bind into every Singularity container.
    // Required when singularity.autoMounts cannot detect your NFS paths.
    // If your bitmask/srprism/genomad_db all live under /nfs, set:
    //   singularity_bind_paths = '/nfs'
    // Multiple paths:
    //   singularity_bind_paths = '/nfs,/scratch,/data'
    singularity_bind_paths = null   // set to your NFS/FSx mount point, e.g. '/nfs' or '/fsx'

    // Contig filtering
    min_contig_length   = 4000

    // Reads preprocessing mode
    // 'raw'                    → raw reads directly into mapping
    // 'host_removed'           → bmtagger → mapping
    // 'trimmed_host_removed'   → fastp → bmtagger → mapping
    reads_mode          = 'raw'

    // Aligner selection
    aligner             = 'auto'        // 'auto' | 'strobealign' | 'bwamem2' | 'bowtie2'
    strobealign_min_len = 150
    bwamem2_min_len     = 100

    // Optional modules
    run_provirus        = false

    // CoverM identity thresholds (per-MGE-type)
    coverm_min_identity_phage   = 0.85
    coverm_min_identity_plasmid = 0.90

    // MultiQC integration (emit to de novo pipeline)
    multiqc_emit        = true
}

// Load base resource config
includeConfig 'conf/base.config'

// Load Singularity container config
includeConfig 'conf/singularity.config'

profiles {
    standard {
        process.executor = 'local'
    }
    test {
        includeConfig 'conf/test.config'
    }
    slurm {
        process.executor = 'slurm'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // Append explicit NFS bind paths when autoMounts is insufficient
        if (params.singularity_bind_paths) {
            singularity.runOptions = "--bind ${params.singularity_bind_paths}"
        }
    }
}

// Global process settings
process {
    errorStrategy = 'retry'
    maxRetries    = 2
}

// Pipeline execution reports
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

manifest {
    name            = 'phage-plasmid-pipeline'
    description     = 'Phage/Plasmid Detection & Abundance Pipeline'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
